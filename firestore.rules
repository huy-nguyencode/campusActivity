/**
 * Firestore Security Rules for Campus Spots
 *
 * LEARNING POINT: Security Rules Are Essential
 *
 * Firestore rules are your last line of defense. Even if your client code
 * is perfect, malicious users can bypass it with direct API calls.
 * Rules run on Firebase's servers and cannot be circumvented.
 *
 * Golden Rule: Never trust the client. Always validate on the server.
 *
 * LEARNING POINT: Rules Syntax
 *
 * Rules use a path-based syntax:
 * - match /collection/{docId} - matches any document in collection
 * - request.auth - the authenticated user (null if not signed in)
 * - request.resource.data - the data being written
 * - resource.data - the existing data (for updates/deletes)
 * - get() / exists() - read other documents for validation
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PLACES COLLECTION
     *
     * Business logic:
     * - Anyone can read places (needed to show on map)
     * - Only Cloud Functions can write most fields (busyPercent updates)
     * - Admins can update busyPercent and adminOverride (for manual overrides)
     *
     * LEARNING POINT: Granular Write Rules
     *
     * Instead of a blanket `allow write: if false`, we split into
     * create, delete, and update. This lets us allow admin updates
     * while still preventing anyone from creating or deleting places.
     *
     * LEARNING POINT: onlyAffects() Pattern
     *
     * The `onlyAffects` helper ensures that even an admin can only
     * modify the specific fields needed for overrides. This is called
     * "field-level security" — even with update permission, the admin
     * can't change the place name, location, or type.
     */
    match /places/{placeId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isAdmin()
                    && onlyAffects(['busyPercent', 'adminOverride']);
    }

    /**
     * CONFIG COLLECTION
     *
     * Stores app-wide configuration (e.g., admin UIDs list).
     * Readable by authenticated users (needed to check admin status).
     * Only editable via Firebase Console (no client writes).
     *
     * LEARNING POINT: Console-Only Collections
     *
     * Some data should never be written by clients. By setting
     * write to false, only Firebase Console and Admin SDK can modify
     * this data. The client can still read it to check permissions.
     */
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    /**
     * CHECKINS COLLECTION
     *
     * Business logic:
     * - Only authenticated users can create check-ins
     * - Users can only check in as themselves (uid must match)
     * - Validate the data structure
     * - No updates or deletes (check-ins are immutable)
     *
     * LEARNING POINT: Data Validation in Rules
     *
     * Validate EVERYTHING:
     * - Required fields exist
     * - Field types are correct
     * - Values are within expected ranges
     * - References point to real documents
     *
     * If validation fails, the write is rejected with permission-denied.
     */
    match /checkins/{checkinId} {
      // Check-ins are now written via a callable Cloud Function so the
      // cooldown can be enforced server-side. Clients no longer need direct
      // read/write access here.
      allow read, create, update, delete: if false;
    }

    match /checkinCooldowns/{docId} {
      allow read, write: if false;
    }

    /**
     * LEARNING POINT: Helper Functions
     *
     * Extract common checks into functions for:
     * 1. Readability - isAuthenticated() is clearer than request.auth != null
     * 2. Reusability - use the same check in multiple rules
     * 3. Maintainability - update logic in one place
     *
     * Functions can only return booleans. They cannot modify data.
     */

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if the authenticated user is an admin.
     *
     * LEARNING POINT: Cross-Document Reads with get()
     *
     * Firestore rules can read other documents using get(). This costs
     * one document read per rule evaluation. The result is cached for
     * the duration of the request, so multiple calls to isAdmin() in
     * the same rule evaluation only cost one read.
     *
     * Note: get() returns null if the document doesn't exist, so we
     * guard with exists() first to prevent null reference errors.
     */
    function isAdmin() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/config/admins)
          && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    /**
     * Ensures an update only modifies the specified fields.
     *
     * LEARNING POINT: Field-Level Security
     *
     * request.resource.data contains ALL fields the document will have
     * after the update. resource.data contains the current fields.
     * By computing the diff (affectedKeys), we can verify that only
     * the allowed fields were changed.
     */
    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /**
     * LEARNING POINT: Catch-All Rule
     *
     * Always deny access to collections you haven't explicitly defined.
     * This prevents accidental exposure if you add new collections but
     * forget to add rules for them.
     *
     * Some teams prefer explicit deny-all:
     *   match /{document=**} { allow read, write: if false; }
     *
     * But this goes at the END and would override specific rules.
     * Better to just not have a catch-all and rely on Firestore's
     * default deny behavior.
     */
  }
}
