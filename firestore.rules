/**
 * Firestore Security Rules for Campus Spots
 *
 * LEARNING POINT: Security Rules Are Essential
 *
 * Firestore rules are your last line of defense. Even if your client code
 * is perfect, malicious users can bypass it with direct API calls.
 * Rules run on Firebase's servers and cannot be circumvented.
 *
 * Golden Rule: Never trust the client. Always validate on the server.
 *
 * LEARNING POINT: Rules Syntax
 *
 * Rules use a path-based syntax:
 * - match /collection/{docId} - matches any document in collection
 * - request.auth - the authenticated user (null if not signed in)
 * - request.resource.data - the data being written
 * - resource.data - the existing data (for updates/deletes)
 * - get() / exists() - read other documents for validation
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PLACES COLLECTION
     *
     * Business logic:
     * - Anyone can read places (needed to show on map)
     * - Only Cloud Functions can write most fields (busyPercent updates)
     * - Admins can update busyPercent and adminOverride (for manual overrides)
     *
     * LEARNING POINT: Granular Write Rules
     *
     * Instead of a blanket `allow write: if false`, we split into
     * create, delete, and update. This lets us allow admin updates
     * while still preventing anyone from creating or deleting places.
     *
     * LEARNING POINT: onlyAffects() Pattern
     *
     * The `onlyAffects` helper ensures that even an admin can only
     * modify the specific fields needed for overrides. This is called
     * "field-level security" — even with update permission, the admin
     * can't change the place name, location, or type.
     */
    match /places/{placeId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isAdmin()
                    && onlyAffects(['busyPercent', 'adminOverride']);
    }

    /**
     * CONFIG COLLECTION
     *
     * Stores app-wide configuration (e.g., admin UIDs list).
     * Readable by authenticated users (needed to check admin status).
     * Only editable via Firebase Console (no client writes).
     *
     * LEARNING POINT: Console-Only Collections
     *
     * Some data should never be written by clients. By setting
     * write to false, only Firebase Console and Admin SDK can modify
     * this data. The client can still read it to check permissions.
     */
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    /**
     * COOLDOWNS COLLECTION (rate-limit locks)
     *
     * LEARNING POINT: Server-Side Rate Limiting with Lock Documents
     *
     * Firestore rules can't query collections (e.g., "find the most recent
     * check-in by this user for this place"). But rules CAN read a single
     * document at a known path using get(). So we create a "lock" document
     * at a predictable path: cooldowns/{uid}__{placeId}.
     *
     * The client writes this lock document alongside each check-in. The
     * check-in rule then uses get() to read the lock and verify the
     * timestamp is old enough. This enforces the cooldown server-side —
     * even if a malicious client skips the AsyncStorage check, Firestore
     * itself rejects the write.
     *
     * Why double underscore? Single underscores could appear in UIDs or
     * placeIds. Double underscore (__) is a safe delimiter since Firebase
     * UIDs and our placeIds never contain it.
     */
    match /cooldowns/{lockId} {
      allow read: if false; // No client reads needed
      allow create: if isAuthenticated()
                    && lockId == (request.auth.uid + '__' + request.resource.data.placeId)
                    && request.resource.data.keys().hasAll(['placeId', 'uid', 'timestamp'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.timestamp is timestamp;
      // Allow update so subsequent check-ins can refresh the lock timestamp
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && isNotOnCooldown(resource.data.timestamp);
      allow delete: if false;
    }

    /**
     * CHECKINS COLLECTION
     *
     * Business logic:
     * - Only authenticated users can create check-ins
     * - Users can only check in as themselves (uid must match)
     * - Validate the data structure
     * - Must pass server-side cooldown check (lock document)
     * - No updates or deletes (check-ins are immutable)
     *
     * LEARNING POINT: Data Validation in Rules
     *
     * Validate EVERYTHING:
     * - Required fields exist
     * - Field types are correct
     * - Values are within expected ranges
     * - References point to real documents
     *
     * If validation fails, the write is rejected with permission-denied.
     */
    match /checkins/{checkinId} {
      // Read: Only own check-ins (prevents scraping all user activity)
      //
      // LEARNING POINT: Principle of Least Privilege
      //
      // Previously any authenticated user could read ALL check-ins.
      // Even though UIDs are anonymous, correlating check-in patterns
      // (same UID, same place, same time every day) can de-anonymize
      // users. Restricting reads to own data minimizes exposure.
      allow read: if isAuthenticated()
                  && resource.data.uid == request.auth.uid;

      // Create: Authenticated users with valid data + cooldown check
      allow create: if isAuthenticated()
                    && isValidCheckIn()
                    && passesServerCooldown();

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    /**
     * LEARNING POINT: Helper Functions
     *
     * Extract common checks into functions for:
     * 1. Readability - isAuthenticated() is clearer than request.auth != null
     * 2. Reusability - use the same check in multiple rules
     * 3. Maintainability - update logic in one place
     *
     * Functions can only return booleans. They cannot modify data.
     */

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if the authenticated user is an admin.
     *
     * LEARNING POINT: Cross-Document Reads with get()
     *
     * Firestore rules can read other documents using get(). This costs
     * one document read per rule evaluation. The result is cached for
     * the duration of the request, so multiple calls to isAdmin() in
     * the same rule evaluation only cost one read.
     *
     * Note: get() returns null if the document doesn't exist, so we
     * guard with exists() first to prevent null reference errors.
     */
    function isAdmin() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/config/admins)
          && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    /**
     * Ensures an update only modifies the specified fields.
     *
     * LEARNING POINT: Field-Level Security
     *
     * request.resource.data contains ALL fields the document will have
     * after the update. resource.data contains the current fields.
     * By computing the diff (affectedKeys), we can verify that only
     * the allowed fields were changed.
     */
    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /**
     * Check if the cooldown period has elapsed.
     *
     * LEARNING POINT: duration.value() for Time Math in Rules
     *
     * Firestore rules support timestamp arithmetic via duration:
     *   timestamp + duration.value(90, 'm')  → timestamp 90 minutes later
     *
     * We compare the lock's stored timestamp + cooldown against the
     * current request time. If "now" is past the cooldown window,
     * the user is allowed to check in again.
     *
     * @param lastTimestamp - The timestamp from the cooldown lock document
     */
    function isNotOnCooldown(lastTimestamp) {
      return request.time > lastTimestamp + duration.value(90, 'm');
    }

    /**
     * Verifies server-side cooldown by reading the lock document.
     *
     * LEARNING POINT: Two-Document Write Pattern
     *
     * The client must write both a check-in AND update the cooldown lock
     * in a single batch. The check-in rule calls this function to verify:
     * 1. If no lock exists → first check-in for this place, allowed
     * 2. If lock exists → check that enough time has passed
     *
     * The get() call costs one document read per rule evaluation, but
     * it's cached for the request — so even if multiple rules call it,
     * it's only billed once.
     */
    function passesServerCooldown() {
      let lockPath = /databases/$(database)/documents/cooldowns/$(request.auth.uid + '__' + request.resource.data.placeId);
      return !exists(lockPath)
          || isNotOnCooldown(get(lockPath).data.timestamp);
    }

    // Validate check-in document structure and values
    function isValidCheckIn() {
      let data = request.resource.data;

      // Required fields must exist
      let hasRequiredFields = data.keys().hasAll(['placeId', 'level', 'timestamp', 'uid']);

      // UID must match the authenticated user (can't check in as someone else)
      let uidMatches = data.uid == request.auth.uid;

      // Level must be 1, 2, or 3
      let validLevel = data.level is int && data.level >= 1 && data.level <= 3;

      // PlaceId must be a non-empty string
      let validPlaceId = data.placeId is string && data.placeId.size() > 0;

      // Timestamp should be a timestamp type
      let validTimestamp = data.timestamp is timestamp;

      // Verify the place actually exists (prevents garbage check-ins)
      let placeExists = exists(/databases/$(database)/documents/places/$(data.placeId));

      return hasRequiredFields
          && uidMatches
          && validLevel
          && validPlaceId
          && validTimestamp
          && placeExists;
    }

    /**
     * LEARNING POINT: Catch-All Rule
     *
     * Always deny access to collections you haven't explicitly defined.
     * This prevents accidental exposure if you add new collections but
     * forget to add rules for them.
     *
     * Some teams prefer explicit deny-all:
     *   match /{document=**} { allow read, write: if false; }
     *
     * But this goes at the END and would override specific rules.
     * Better to just not have a catch-all and rely on Firestore's
     * default deny behavior.
     */
  }
}
